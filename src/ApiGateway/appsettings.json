{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "PartnerService": "http://partner-service:8080"
  },
  "Geolocalization": {
    "GrpcAddress": "http://geolocation-service:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "partner-get-by-id": {
        "ClusterId": "partner-service",
        "Match": {
          "Path": "/partners/{id}",
          "Methods": [ "GET" ]
        }
      },
      "partner-create": {
        "ClusterId": "partner-service",
        "Match": {
          "Path": "/partners",
          "Methods": [ "POST" ]
        }
      }
    },
    "Clusters": {
      "partner-service": {
        "Destinations": {
          "partner-service": {
            "Address": "http://partner-service:8080"
          }
        }
      }
    }
  }
}
